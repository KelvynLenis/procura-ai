# =============================================================================
# ProcuraAI - Variaveis de ambiente
# =============================================================================
#
# Copie para .env e preencha os valores do ambiente desejado.
#
# Ambientes:
#   Local:   http://localhost:3000
#   Homolog: https://procuraai-homolog.secties.pb.gov.br
#   Vercel:  https://procura-ai.vercel.app
#
# URL base e callback Gov.br:
#   - Em producao/homolog/vercel: deixe vazio para deteccao automatica
#     (usa headers X-Forwarded-* no nginx ou origin da request na Vercel).
#   - Se precisar forcar manualmente, use URL completa com https://
#   - NUNCA use localhost em deploy (Vercel ou servidor).
#
# =============================================================================

# --- URL base (opcional em producao) ---
# Local:     http://localhost:3000
# Homolog:   https://procuraai-homolog.secties.pb.gov.br
# Vercel:    https://procura-ai.vercel.app
NEXT_PUBLIC_BASE_URL=

# --- Appwrite ---
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_WRITE_PROJECT_ID=
NEXT_PUBLIC_APP_WRITE_API_KEY=
NEXT_PUBLIC_APP_WRITE_STORAGE_ID=
NEXT_PUBLIC_DATABASE_ID=

# --- Colecoes ---
NEXT_PUBLIC_COLLECTION_DEVICE=
NEXT_PUBLIC_COLLECTION_USER=
NEXT_PUBLIC_COLLECTION_CONTACTS=
NEXT_PUBLIC_COLLECTION_EVENTS=
NEXT_PUBLIC_COLLECTION_DISTRICT=
NEXT_PUBLIC_COLLECTION_OPERATORS=
NEXT_PUBLIC_COLLECTION_NOTIFICATION=
NEXT_PUBLIC_COLLECTION_VERIFICATION_CODES=
NEXT_PUBLIC_COLLECTION_TRANSFER_TOKENS=

# --- Gov.br OAuth ---
NEXT_PUBLIC_GOVBR_SSO_URL=https://sso.codata.pb.gov.br/auth/
NEXT_PUBLIC_GOVBR_REALM=paraiba
NEXT_PUBLIC_GOVBR_CLIENT_ID=
NEXT_PUBLIC_GOVBR_CLIENT_SECRET=

# Callback OAuth (opcional em producao — detectado como {BASE_URL}/api/login-gov/callback)
# Local:     http://localhost:3000/api/login-gov/callback
# Homolog:   https://procuraai-homolog.secties.pb.gov.br/api/login-gov/callback
# Vercel:    https://procura-ai.vercel.app/api/login-gov/callback
NEXT_PUBLIC_GOVBR_REDIRECT_URI=

# Endpoint mobile (app Expo/React Native — fora deste repo web)
EXPO_PUBLIC_GOVBR_AUTH_ENDPOINT=

# --- GeoJSON ---
NEXT_PUBLIC_NEIGHBORHOODS_GEOJSON_URL=
NEXT_PUBLIC_PARAIBA_GEOJSON_URL=

# --- Mapas ---
NEXT_PUBLIC_MAPTILER_API_KEY=
NEXT_PUBLIC_GEOCODE_API_KEY=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_SCRIPT=

# --- Email (preferir sem NEXT_PUBLIC_ — lidas no servidor em runtime) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Legado (evitar em producao; valores ficam embutidos no build)
NEXT_PUBLIC_GMAIL_USER=
NEXT_PUBLIC_GMAIL_APP_PASSWORD=

# --- Outros ---
NEXT_PUBLIC_API_KEY_IMEICHECK=
NEXT_PUBLIC_APK_DOWNLOAD_LINK=

# production | development
# Homolog/Vercel em HTTPS: use production (habilita cookies secure no login Gov.br)
NEXT_PUBLIC_NODE_ENV=
