# Dockerfile simples para produção
FROM node:20-alpine

WORKDIR /app

# Instalar dependências de build
COPY package*.json ./
RUN npm ci

# Copiar código
COPY . .

# Build da aplicação
RUN npm run build

# Remover dependências de desenvolvimento (economizar espaço)
RUN npm prune --production

# Expor porta
EXPOSE 3000

# Iniciar aplicação
CMD ["npm", "start"]
